---
export const prerender = true;
import ContactUs from "@components/ContactUs.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const site = Astro.site ?? Astro.url;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.toString() },
    { "@type": "ListItem", position: 2, name: "Contact Us", item: new URL("/contact", site).toString() },
  ],
};
---
<BaseLayout
  title="Contact Us | AI With Ease"
  description="Get in touch with AI With Ease in Cape Town. Book a free discovery call or send a message to start your AI tool assessment, coaching, or team workshop."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>
  <ContactUs />
</BaseLayout>