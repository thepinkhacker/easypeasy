---
import BaseLayout from "@layouts/BaseLayout.astro";
import Calendly from "@components/Calendly.astro";
---
<BaseLayout title="Book a Discovery Call | AI With Ease">
  <h1 class="mx-auto mt-16 max-w-2xl px-4 text-center text-3xl font-bold text-gray-900 sm:text-4xl">
    Book Your Free Discovery Call
  </h1>
  <p class="mx-auto mt-4 max-w-xl px-4 text-center text-lg text-gray-600">
    Pick a time that works for you and let's chat about how AI can help your business.
  </p>
  <Calendly />
</BaseLayout>
