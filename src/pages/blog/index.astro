---
export const prerender = true;
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Blog | AI With Ease"
  description="Practical AI insights, guides, and updates from AI With Ease — helping Cape Town businesses put AI to work."
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-center text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
      Blog
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-gray-600">
      Practical AI insights and guides for small businesses and busy professionals.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}/`}
          class="flex flex-col overflow-hidden rounded-xl border border-gray-200 shadow-sm transition-shadow hover:shadow-lg"
        >
          <Image src={post.data.cover} alt={post.data.coverAlt} class="h-48 w-full object-cover" />
          <div class="flex flex-1 flex-col gap-2 p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              {post.data.publishDate.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="text-lg font-semibold text-gray-900">{post.data.title}</h2>
            <p class="text-sm text-gray-600">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
