---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | AI With Ease Blog`} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">
      {post.data.publishDate.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
      {post.data.title}
    </h1>
    <Image src={post.data.cover} alt={post.data.coverAlt} class="mt-8 w-full rounded-2xl object-cover" />
    <div class="prose prose-gray mt-8 max-w-none prose-headings:font-semibold prose-headings:text-gray-900 prose-a:text-teal-600 prose-strong:text-gray-900">
      <Content />
    </div>
  </article>
</BaseLayout>
