---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import '@fontsource-variable/sen/wght.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "AI With Ease helps small businesses, growing teams, and busy professionals put AI to work without losing the human element, through AI tool assessments, individualised coaching, and team training workshops.",
  image = "full-logo.png",
} = Astro.props;

const site = Astro.site ?? Astro.url;
const ogImage = new URL(image, site);
const canonicalUrl = new URL(Astro.url.pathname, site);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "AI With Ease",
  url: site.toString(),
  logo: ogImage.toString(),
  image: ogImage.toString(),
  email: "hello@aiwithease.net",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Cape Town",
    addressCountry: "ZA",
  },
  areaServed: ["Cape Town, South Africa", "Worldwide (remote/online)"],
  sameAs: [
    "https://www.linkedin.com/company/ai-with-ease/",
    "https://www.instagram.com/aiwithease_/",
  ],
  description,
};
---
<html data-theme="light" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)}></script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script src="https://web3forms.com/client/script.js" async defer></script>
  </body>
</html>