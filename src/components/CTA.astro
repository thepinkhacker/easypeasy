---
import Calendly from "@components/Calendly.astro";
---

<section class="bg-gray-900 px-4 py-16 text-center sm:px-6 lg:px-8">
    <p class="text-lg font-semibold text-teal-400 p-2">This is your moment</p>
  <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
    Ready to put AI to work in your business?
  </h2>
  <p class="mx-auto mt-4 max-w-xl text-lg text-gray-300">
    Book a free, 15 minute, no obligation discovery call and see how AI can help you help you save time, increase revenue, and grow your business.
  </p>
  <div class="mt-8">
 <Calendly buttonText="Book your free discovery call" buttonColor="white" 
 textColor="black" />
 </div>
</section>
