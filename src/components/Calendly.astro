---
export interface Props {
  buttonText?: string;
  buttonColor?: string;
  textColor?: string;
}

const { buttonText = "Book your free discovery call", buttonColor = "#00bba7", textColor = "white" } = Astro.props;

const KOALENDAR_URL = "https://koalendar.com/e/meet-ai-with-ease";
---

<!-- Koalendar link widget begin -->
<script is:inline>window.Koalendar=window.Koalendar||function(){(Koalendar.props=Koalendar.props||[]).push(arguments)};</script>
<script is:inline async src="https://koalendar.com/assets/widget.js"></script>
<script is:inline>Koalendar('init');</script>
<a
  class="inline-block rounded-md px-6 py-3 text-sm font-semibold transition hover:brightness-90"
  style={`background-color: ${buttonColor}; color: ${textColor}`}
  data-koalendar-widget
  href={KOALENDAR_URL}
>
  {buttonText}
</a>
<!-- Koalendar link widget end -->