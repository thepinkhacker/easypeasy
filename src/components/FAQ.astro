---
const faqs = [
  {
    question: "What is AI With Ease?",
    answer:
      "AI With Ease is a set of practical, jargon-free lessons that help you understand and use AI with confidence, no experience required.",
  },
  {
    question: "Do I need any technical background?",
    answer:
      "Not at all. Our lessons are built for solopreneurs, small businesses, and creators who want results, not a computer science degree.",
  },
  {
    question: "How much time will it take?",
    answer:
      "Most people see real results in just a few hours spread across a week, at whatever pace suits you.",
  },
  {
    question: "Can I get support along the way?",
    answer:
      "Yes, every offer includes access to support so you're never stuck figuring things out alone.",
  },
];
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="text-center text-2xl font-semibold text-gray-900 sm:text-3xl">
    Frequently Asked Questions
  </h2>

  <div class="mt-10 flex flex-col gap-3">
    {faqs.map((faq) => (
      <details class="faq-item group rounded-lg border border-gray-200 px-5 py-4">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
          <span class="font-bold text-gray-900">{faq.question}</span>
          <span
            class="faq-icon relative mt-1 h-5 w-5 flex-none text-gray-500"
            aria-hidden="true"
          ></span>
        </summary>
        <p class="mt-3 text-sm text-gray-600">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: currentColor;
    transition: transform 0.2s ease;
  }

  .faq-icon::before {
    width: 100%;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .faq-icon::after {
    width: 2px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg) scale(0);
  }
</style>
