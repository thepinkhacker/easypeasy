---
export interface Faq {
  question: string;
  answer: string;
}

export interface Props {
  faqs?: Faq[];
}

const {
  faqs = [
    {
      question: "Do I need any AI experience to work with you?",
      answer:
        "Not at all. We work with businesses who are just starting out with AI, as well as those who have some experience but want to take their skills and impact to the next level.",
    },
    {
      question: "Do you recommend specific AI tools, or is this more about strategy?",
      answer:
        "While we will include a focus on strategy and implementation, we do also recommend specific AI tools that are best suited for your business needs. We will help you choose the right tools and show you how to use them effectively.",
    },
    {
      question: "How quickly will I start seeing results?",
      answer:
        "In your roadmap there will be quick wins along with longer-term strategies. It's possible to see results within just a week, but the full benefits will keep growing over time as you implement your AI strategy and continue to optimize your processes.",
    },
    {
      question: "Do you work with international clients, or only businesses in South Africa?",
      answer:
        "We work with businesses locally and internationally. Sessions and workshops can be conducted online, no matter where you are located. We also offer in-person sessions for local clients in Cape Town, South Africa.",
    },
    {
      question: "How do I know which service is right for me?",
      answer:
        "While we recommend new clients start with an AI Tool Assessment, we offer a free 15 minute discovery call to help you determine which service is best suited for your business and team needs. Please reach out to us and we will gladly point you in the right direction!",
    },
  ],
}: Props = Astro.props;
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="text-center text-2xl font-semibold text-gray-900 sm:text-3xl">
    Frequently Asked Questions
  </h2>

  <div class="mt-10 flex flex-col gap-3">
    {faqs.map((faq) => (
      <details class="faq-item group rounded-lg border border-gray-200 px-5 py-4">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
          <span class="font-bold text-gray-900">{faq.question}</span>
          <span
            class="faq-icon relative mt-1 h-5 w-5 flex-none text-gray-500"
            aria-hidden="true"
          ></span>
        </summary>
        <p class="mt-3 text-sm text-gray-600">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: currentColor;
    transition: transform 0.2s ease;
  }

  .faq-icon::before {
    width: 100%;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .faq-icon::after {
    width: 2px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg) scale(0);
  }
</style>
