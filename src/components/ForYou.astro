---
const items = ["Small Businesses", "Growing Teams", "Busy Professionals", "You"];
---

<section class="flex flex-col bg-gray-200 items-center justify-center gap-3 px-4 py-16 text-center">
  <p class="text-2xl font-bold text-gray-900 sm:text-3xl">
    AI solutions tailored to:
  </p>

  <div class="relative h-14 w-full max-w-md overflow-hidden sm:h-16 sm:max-w-xl">
    {items.map((item, i) => (
      <span
        class="cycle-word absolute inset-0 flex items-center justify-center text-4xl font-bold text-teal-500 sm:text-5xl"
        style={`animation-delay: ${((items.length - i) % items.length) * -2}s`}
      >
        {item}
      </span>
    ))}
  </div>
</section>

<style>
  @keyframes cycle-word {
    0%,
    3% {
      opacity: 0;
      transform: translateY(6px);
    }
    6%,
    19% {
      opacity: 1;
      transform: translateY(0);
    }
    22%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes countdown {
    0% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }

  .cycle-word {
    animation: cycle-word 8s ease-in-out infinite;
  }
</style>
