---
export interface Feature {
  title: string;
  description: string;
}

export interface Props {
  heading?: string;
  features?: Feature[];
}

const {
  heading = "Why Choose Us",
  features = [
    {
      title: "Years of AI Experience",
      description: "We've been using AI since the beginning and have seen it grow and change. We know what works and what doesn't, and we can help you get the most out of AI in your business.",
    },
    {
      title: "Clear and Actionable Guidance",
      description: "We believe in giving you everything you need to take action, not just a laundry list full of jargon.",
    },
    {
      title: "Built by Local, for Local",
      description: "We're a small business ourselves, and we understand the challenges of running a business in South Africa.",
    },
    {
      title: "Focus on People, Not Just Technology",
      description: "We believe AI should be your creative partner, not your replacement. We focus on helping you get the most out of AI while keeping your unique voice and vision intact.",
    },
  ],
}: Props = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <h2 class="text-center text-2xl font-semibold text-gray-900 sm:text-3xl">
    {heading}
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2">
    {features.map((feature) => (
      <div class="rounded-xl border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900">{feature.title}</h3>
        <p class="mt-2 text-sm text-gray-600">{feature.description}</p>
      </div>
    ))}
  </div>
</section>
