---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 py-10 sm:px-6 lg:px-8">
    <ul class="flex items-center gap-6">
      {socials.map((social) => (
        <li>
          <a
            href={social.href}
            aria-label={social.name}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 transition-colors hover:text-gray-900"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d={social.path} />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="text-sm text-gray-500">
      Copyright &copy; {year} AI With Ease. All rights reserved.
    </p>
    <p class="text-sm text-gray-500">
      Made with ❤️ by <a href="https://ui-together.com" target="_blank" >UI-Together</a>
    </p>
  </div>
</footer>
